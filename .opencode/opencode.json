{
  "$schema": "https://opencode.ai/config.json",

  "model": "openrouter/poolside/laguna-s-2.1:free",
  "small_model": "zen/big-pickle",

  "agent": {
    "plan": {
      "mode": "primary",
      "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },

    "build": {
      "mode": "primary",
      "model": "openrouter/poolside/laguna-s-2.1:free",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },

    "frontend": {
      "description": "React, Tailwind and responsive UI specialist.",
      "mode": "subagent",
      "model": "openrouter/poolside/laguna-s-2.1:free"
    },

    "backend": {
      "description": "Backend architecture and API specialist.",
      "mode": "subagent",
      "model": "zen/big-pickle"
    },

    "animation": {
      "description": "Creates performant Framer Motion and CSS animations.",
      "mode": "subagent",
      "model": "openrouter/poolside/laguna-s-2.1:free"
    },

    "reviewer": {
      "description": "Reviews code quality, maintainability and best practices.",
      "mode": "subagent",
      "model": "openrouter/cohere/north-mini-code:free"
    },

    "debugger": {
      "description": "Root-cause analysis and debugging specialist.",
      "mode": "subagent",
      "model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free"
    },

    "accessibility": {
      "description": "WCAG accessibility specialist.",
      "mode": "subagent",
      "model": "openrouter/cohere/north-mini-code:free"
    },

    "documentation": {
      "description": "Writes concise technical documentation.",
      "mode": "subagent",
      "model": "openrouter/inclusionai/ling-3.0-flash:free"
    }
  },
   "mcp": {
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "enabled": true
      }
  }
}