---
import BaseLayout from '../layouts/BaseLayout.astro'
import AstraText from '../components/AstraText.astro'
import Navbar from '../components/Navbar.astro'
import Hero from '../components/Hero.astro'
---

<BaseLayout>
  <Navbar />
  <AstraText />
  <Hero />

  <main>
    <section id="work" class="min-h-screen flex items-center bg-brand px-6 pt-32 pb-24">
      <div class="max-w-5xl mx-auto w-full">
        <p class="text-xs font-mono tracking-[0.25em] uppercase text-brand-inverse/25 mb-12">
          / 01 &mdash; Selected Projects
        </p>

        <div class="grid md:grid-cols-2 gap-12 md:gap-16">
          <div class="space-y-4">
            <div class="w-full aspect-[4/3] bg-white/5 rounded-sm" />
            <h3 class="text-2xl md:text-3xl font-light tracking-tight text-brand-inverse/90">
              Nebula Platform
            </h3>
            <p class="text-sm text-brand-inverse/40 leading-relaxed max-w-sm">
              A real-time data visualization platform for astrophysical research.
              Designed for clarity at scale, with interactive 3D renderings of stellar
              formation models.
            </p>
            <span class="inline-block text-[10px] font-mono tracking-widest uppercase text-brand-inverse/20 border border-brand-inverse/10 rounded-full px-3 py-1">
              Design &amp; Engineering
            </span>
          </div>

          <div class="space-y-4">
            <div class="w-full aspect-[4/3] bg-white/5 rounded-sm" />
            <h3 class="text-2xl md:text-3xl font-light tracking-tight text-brand-inverse/90">
              Meridian Finance
            </h3>
            <p class="text-sm text-brand-inverse/40 leading-relaxed max-w-sm">
              A wealth management dashboard reimagined from the ground up.
              Reduced cognitive load by 60% through progressive disclosure and
              thoughtful typographic hierarchy.
            </p>
            <span class="inline-block text-[10px] font-mono tracking-widest uppercase text-brand-inverse/20 border border-brand-inverse/10 rounded-full px-3 py-1">
              Product Design
            </span>
          </div>

          <div class="space-y-4">
            <div class="w-full aspect-[4/3] bg-white/5 rounded-sm" />
            <h3 class="text-2xl md:text-3xl font-light tracking-tight text-brand-inverse/90">
              Luma Studio
            </h3>
            <p class="text-sm text-brand-inverse/40 leading-relaxed max-w-sm">
              A brand identity and marketing site for an architectural lighting studio.
              Every interaction reinforces the sensory experience of light in space.
            </p>
            <span class="inline-block text-[10px] font-mono tracking-widest uppercase text-brand-inverse/20 border border-brand-inverse/10 rounded-full px-3 py-1">
              Brand &amp; Web
            </span>
          </div>

          <div class="space-y-4">
            <div class="w-full aspect-[4/3] bg-white/5 rounded-sm" />
            <h3 class="text-2xl md:text-3xl font-light tracking-tight text-brand-inverse/90">
              Cascade Sound
            </h3>
            <p class="text-sm text-brand-inverse/40 leading-relaxed max-w-sm">
              A spatial audio player for exploratory listening. Built with
              WebGL visualizations that respond to frequency and amplitude in
              real time.
            </p>
            <span class="inline-block text-[10px] font-mono tracking-widest uppercase text-brand-inverse/20 border border-brand-inverse/10 rounded-full px-3 py-1">
              Interactive &amp; Audio
            </span>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="min-h-screen flex items-center bg-surface text-brand px-6 pt-32 pb-24">
      <div class="max-w-5xl mx-auto w-full">
        <p class="text-xs font-mono tracking-[0.25em] uppercase text-brand/25 mb-12">
          / 02 &mdash; Practice
        </p>

        <div class="md:w-3/5 space-y-8">
          <p class="text-3xl md:text-5xl font-light leading-tight tracking-tight text-brand/85">
            We help organizations craft digital experiences that feel intentional,
            performant, and human.
          </p>

          <div class="space-y-5 text-sm md:text-base text-brand/50 leading-relaxed">
            <p>
              Founded in 2020, ASTRA is a small, independent design and engineering
              studio. We work with early-stage startups and established companies to
              design systems, build products, and refine brands. Our practice is
              research-driven, detail-obsessed, and anchored in the belief that great
              design is invisible.
            </p>
            <p>
              We specialise in typography-heavy interfaces, data-rich dashboards,
              and interactive storytelling. Every project begins with understanding
              the people who will use it, and ends with a system that can grow with
              them. We favour long-term partnerships over one-off engagements.
            </p>
          </div>

          <div class="grid grid-cols-3 gap-8 pt-8 border-t border-brand/10">
            <div>
              <p class="text-3xl font-light text-brand/90">6+</p>
              <p class="text-xs text-brand/40 mt-1">Years in practice</p>
            </div>
            <div>
              <p class="text-3xl font-light text-brand/90">40+</p>
              <p class="text-xs text-brand/40 mt-1">Projects delivered</p>
            </div>
            <div>
              <p class="text-3xl font-light text-brand/90">&#8734;</p>
              <p class="text-xs text-brand/40 mt-1">Iterations enjoyed</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="min-h-screen flex items-center bg-brand px-6 pt-32 pb-24">
      <div class="max-w-5xl mx-auto w-full">
        <p class="text-xs font-mono tracking-[0.25em] uppercase text-brand-inverse/25 mb-12">
          / 03 &mdash; Get in touch
        </p>

        <div class="md:w-3/5 space-y-10">
          <p class="text-3xl md:text-6xl font-light leading-tight tracking-tight text-brand-inverse/85">
            Have a project in mind? Let&rsquo;s talk.
          </p>

          <div class="space-y-3">
            <a href="mailto:hello@astra.studio" class="block text-xl md:text-2xl font-light text-brand-inverse/60 hover:text-brand-inverse transition-colors duration-300">
              hello@astra.studio
            </a>
            <a href="tel:+1234567890" class="block text-xl md:text-2xl font-light text-brand-inverse/40 hover:text-brand-inverse transition-colors duration-300">
              +1 (234) 567-890
            </a>
          </div>

          <div class="flex gap-8 pt-6 border-t border-brand-inverse/10">
            <a href="#" class="text-xs font-mono tracking-widest uppercase text-brand-inverse/30 hover:text-brand-inverse transition-colors duration-300">
              Twitter
            </a>
            <a href="#" class="text-xs font-mono tracking-widest uppercase text-brand-inverse/30 hover:text-brand-inverse transition-colors duration-300">
              LinkedIn
            </a>
            <a href="#" class="text-xs font-mono tracking-widest uppercase text-brand-inverse/30 hover:text-brand-inverse transition-colors duration-300">
              GitHub
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { initSmoothScroll } from '../scripts/lenis'
    import { initHeroReveal } from '../scripts/animation'
    import { initScrollMorph } from '../scripts/scroll'

    const start = () => {
      const astra = document.getElementById('astra-logo')
      const heroContent = document.getElementById('hero-content')
      const cta = heroContent?.querySelector('a')
      if (!astra) return

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      Promise.race([
        document.fonts.ready,
        new Promise<void>((resolve) => setTimeout(resolve, 2500)),
      ]).then(() => {
        if (reduced) {
          const vw = window.innerWidth
          astra.style.animation = 'none'
          astra.style.transition = 'none'
          astra.style.transform = `translate(${vw * 0.04}px, 20px)`
          astra.style.fontSize = '1.25rem'
          astra.style.letterSpacing = '-0.04em'
          astra.style.fontWeight = '500'
          heroContent?.style.removeProperty('opacity')
          cta?.style.removeProperty('opacity')
          document.querySelector('#hero > div')?.style.removeProperty('opacity')
          return
        }

        const style = getComputedStyle(astra)
        const fontSize = parseFloat(style.fontSize) / 16

        initHeroReveal()
        initSmoothScroll()
        initScrollMorph(fontSize)
      })
    }

    if (document.readyState === 'complete') {
      start()
    } else {
      window.addEventListener('load', start)
    }
  </script>
</BaseLayout>
